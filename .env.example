# Agent Deck configuration
# Copy to .env and adjust. Never commit .env with a real token.

# Backend bind address — keep 127.0.0.1 unless you are on a secured private network.
AGENT_HUB_HOST=127.0.0.1
AGENT_HUB_PORT=8765

# SQLite database (relative paths resolve from the backend/ directory).
AGENT_HUB_DATABASE_URL=sqlite:///./agent_hub.db

# Token required for all write endpoints (Authorization: Bearer <token>).
# Empty = writes allowed without a token (local development only).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_HUB_WRITE_TOKEN=

# Allowed CORS origins for the dashboard (comma-separated).
AGENT_HUB_CORS_ORIGINS=http://localhost:3000

# Discord channel webhook that receives a summary when a task finishes, fails or
# is blocked. Create it in Discord: Edit Channel -> Integrations -> Webhooks.
# This is NOT the "Webhooks" page of the Discord Developer Portal — that one
# sends Discord's events out to another app. Empty disables the notifications.
# AGENT_HUB_DISCORD_SUMMARY_WEBHOOK=https://discord.com/api/webhooks/.../...

# A worker with no heartbeat for this long is shown as offline (stale). Must stay
# comfortably above the interval of the "AgentHub Heartbeat" scheduled task
# (15 minutes), otherwise the worker flaps to offline between two beats.
AGENT_HUB_WORKER_STALE_SECONDS=1200

# --- OpenACP channel bindings ---------------------------------------------
# Plugin settings file of @openacp/discord-adapter. WARNING: this file also
# holds the Discord bot token — the API exposes only its "channelBindings" key.
# AGENT_HUB_OPENACP_SETTINGS_PATH=C:\Users\you\openacp-workspace\.openacp\plugins\data\@openacp\discord-adapter\settings.json
# AGENT_HUB_OPENACP_AGENTS_PATH=C:\Users\you\openacp-workspace\.openacp\agents.json
# AGENT_HUB_OPENACP_BINDINGS_MODULE_DIR=C:\agent-hub\openacp-channel-bindings
# Backups are full copies of the settings file (token included) — keep them out
# of version control.
# AGENT_HUB_OPENACP_SETTINGS_BACKUP_DIR=C:\Users\you\.agent-hub\settings-backups
# AGENT_HUB_OPENACP_BACKUP_RETENTION=20
# AGENT_HUB_OPENACP_HOOK_TIMEOUT_SECONDS=120
# Timeout for the dashboard's "Install OpenACP" button (global npm install).
# AGENT_HUB_OPENACP_INSTALL_TIMEOUT_SECONDS=300

# --- Screenshots (System page) --------------------------------------------
# Where captured PNGs are written (relative to backend/).
# AGENT_HUB_SCREENSHOT_DIR=./screenshots
# AGENT_HUB_SCREENSHOT_INSTALL_TIMEOUT_SECONDS=180

# --- Used by the agent-report CLI -----------------------------------------
AGENT_HUB_URL=http://127.0.0.1:8765
